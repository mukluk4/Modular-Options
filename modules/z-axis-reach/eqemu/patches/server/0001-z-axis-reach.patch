+// Vertical reach (z-axis-reach module): melee and aggro ignored height, so a mob on a ledge or the floor above could hit or
+// notice you. The gap is measured feet to feet (z less the model's z offset) and may be at most base + the bigger
+// of the two sizes, so large models still reach further. A base of 0 or less turns it off.
+static bool WithinZReach(const Mob *a, const Mob *b, float base, float size_a, float size_b)
+{
+	if (base <= 0.0f) {
+		return true;
+	}
+
+	const float gap = std::abs((a->GetZ() - a->GetZOffset()) - (b->GetZ() - b->GetZOffset()));
+	return gap <= base + std::max(size_a, size_b);
+}
