+	// The folded spells that count right now: not beaten by a real buff (the same spell as a real buff counts
+	// once, through that buff), and among themselves only the winner of each stacking conflict.
+	std::vector<uint16> ResonanceActive(Client *c, const std::vector<uint16> &folded, int res_slot)
+	{
+		std::vector<uint16> active;
+		auto *buffs = c->GetBuffs();
+		const int buff_count = c->GetMaxTotalSlots();
+		const uint16 res = ResonanceSpellId();
+
+		for (const auto spell_id : folded) {
+			const int level = c->GetCasterLevel(spell_id);
+
+			bool blocked = false;
+			for (int slot = 0; slot < buff_count && !blocked; ++slot) {
+				const uint16 buff_spell = buffs[slot].spellid;
+				if (slot == res_slot || buff_spell == res || !IsValidSpell(buff_spell)) {
+					continue;
+				}
+				blocked = buff_spell == spell_id ||
+					c->CheckStackConflict(buff_spell, buffs[slot].casterlevel, spell_id, level, nullptr, c, slot) == -1;
+			}
+			if (blocked) {
+				continue;
+			}
+
+			bool keep = true;
+			for (auto it = active.begin(); it != active.end();) {
+				const int ret = c->CheckStackConflict(*it, c->GetCasterLevel(*it), spell_id, level, c, c, res_slot);
+				if (ret == -1) {
+					keep = false;
+					break;
+				}
+				if (ret == 1) {
+					it = active.erase(it); // the new one is stronger
+					continue;
+				}
+				++it;
+			}
+			if (keep) {
+				active.push_back(spell_id);
+			}
+		}
+		return active;
+	}
+
+	// Keeps the one buff in step with the folded list: fades the vault's old separate copies of folded
+	// spells and any weaker real buff a folded spell beats (a separate vault buff would have overwritten
+	// it), adds Vault Resonance when something folds and removes it when nothing does.
+	void ResonanceSync(Client *c, bool recalc)
+	{
+		if (!c) {
+			return;
+		}
+		std::vector<uint16> folded;
+		auto cached = locker_cache.find(c->CharacterID());
+		if (cached != locker_cache.end() && ResonanceOn()) {
+			folded = cached->second.folded;
+		}
+
+		int res_slot = ResonanceSpellId() ? FindResonanceSlot(c) : -1;
+		if (folded.empty()) {
+			if (res_slot >= 0) {
+				c->BuffFadeBySlot(res_slot);
+			}
+			return;
+		}
+
+		const int before = c->GetBuffs() ? c->GetMaxTotalSlots() : 0;
+		int faded = 0;
+		for (const auto spell_id : folded) {
+			auto *b = c->GetBuffs();
+			for (int slot = 0; slot < before; ++slot) {
+				if (b[slot].spellid == spell_id && b[slot].ticsremaining == PERMANENT_BUFF_DURATION) {
+					c->BuffFadeBySlot(slot, false); // the vault's old separate copy (changeover)
+					++faded;
+					break;
+				}
+			}
+		}
+		if (faded) {
+			res_slot = FindResonanceSlot(c);
+		}
+
+		auto *buffs = c->GetBuffs();
+		const int buff_count = c->GetMaxTotalSlots();
+		for (const auto spell_id : ResonanceActive(c, folded, res_slot)) {
+			const int level = c->GetCasterLevel(spell_id);
+			for (int slot = 0; slot < buff_count; ++slot) {
+				const uint16 buff_spell = buffs[slot].spellid;
+				if (slot == res_slot || buff_spell == ResonanceSpellId() || buff_spell == spell_id ||
+					!IsValidSpell(buff_spell) || !IsBeneficialSpell(buff_spell)) {
+					continue;
+				}
+				if (c->CheckStackConflict(buff_spell, buffs[slot].casterlevel, spell_id, level, nullptr, c, slot) == 1) {
+					LogSpells("Vault Resonance: [{}] beats [{}] in slot [{}], fading it", spell_id, buff_spell, slot);
+					c->BuffFadeBySlot(slot, false);
+					++faded;
+				}
+			}
+		}
+
+		if (FindResonanceSlot(c) < 0) {
+			c->ApplySpellBuff(ResonanceSpellId(), PERMANENT_BUFF_DURATION);
+			recalc = true;
+		}
+		if (recalc || faded) {
+			c->CalcBonuses();
+		}
+	}
