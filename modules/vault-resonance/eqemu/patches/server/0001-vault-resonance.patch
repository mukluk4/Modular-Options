+	std::vector<uint16> BuildFolded(Client *c, const std::vector<uint32> &clicky_items)
+	{
+		std::vector<uint16> folded;
+		if (!ResonanceOn()) {
+			return folded;
+		}
+		for (const auto item_id : clicky_items) {
+			const auto *item = database.GetItem(item_id);
+			if (!CanUseVaultClicky(c, item)) {
+				continue;
+			}
+			const auto spell_id = static_cast<uint16>(item->Click.Effect);
+			if (IsFoldableSpell(spell_id) && std::find(folded.begin(), folded.end(), spell_id) == folded.end()) {
+				folded.push_back(spell_id);
+			}
+		}
+		return folded;
+	}
