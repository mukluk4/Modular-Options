+// ---- Vault Resonance, called from the spell code ----
+
+bool NmsVaultIsResonanceSpell(uint16 spell_id)
+{
+	return spell_id != 0 && spell_id == ResonanceSpellId() && IsValidSpell(spell_id);
+}
+
+// Mob::CalcSpellBonuses, for the Vault Resonance slot: every folded spell that counts right now, as if it
+// were its own buff
+void NmsVaultResonanceBonuses(Client *c, StatBonuses *b, int slot)
+{
+	if (!c || !b || !ResonanceOn()) {
+		return;
+	}
+	auto cached = locker_cache.find(c->CharacterID());
+	if (cached == locker_cache.end() || cached->second.folded.empty()) {
+		return;
+	}
+	for (const auto spell_id : ResonanceActive(c, cached->second.folded, slot)) {
+		c->ApplySpellsBonuses(spell_id, static_cast<uint8>(c->GetCasterLevel(spell_id)), b, c->GetID(), 0,
+			PERMANENT_BUFF_DURATION, slot);
+	}
+}
+
+// Mob::AddBuff / CanBuffStack: true when a folded spell that counts beats the incoming buff, so a weaker
+// buff doesn't take hold, exactly as if the vault spell were its own buff. The same spell is let through:
+// it lands, and the folded copy steps aside while it lasts.
+bool NmsVaultResonanceBlocks(Client *c, uint16 spell_id, int caster_level)
+{
+	if (!c || !ResonanceOn() || spell_id == ResonanceSpellId() || !IsValidSpell(spell_id) ||
+		!IsBeneficialSpell(spell_id)) {
+		return false;
+	}
+	auto cached = locker_cache.find(c->CharacterID());
+	if (cached == locker_cache.end() || cached->second.folded.empty()) {
+		return false;
+	}
+	const int res_slot = FindResonanceSlot(c);
+	if (res_slot < 0) {
+		return false;
+	}
+	for (const auto folded : ResonanceActive(c, cached->second.folded, res_slot)) {
+		if (folded == spell_id) {
+			continue;
+		}
+		if (c->CheckStackConflict(folded, c->GetCasterLevel(folded), spell_id, caster_level, c, nullptr, res_slot) == -1) {
+			return true;
+		}
+	}
+	return false;
+}
