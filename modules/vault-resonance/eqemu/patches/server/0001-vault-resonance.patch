+	bool IsFoldableSpell(uint16 spell_id)
+	{
+		if (!IsValidSpell(spell_id) || !IsPermanentVaultClicky(spell_id)) {
+			return false;
+		}
+		const auto &sp = spells[spell_id];
+		if (sp.short_buff_box || sp.hit_number > 0 || IsBardSong(spell_id)) {
+			return false;
+		}
+		bool any = false;
+		for (int i = 0; i < EFFECT_COUNT; ++i) {
+			if (IsBlankSpellEffect(spell_id, i)) {
+				continue;
+			}
+			if (!IsResonanceStatEffect(spell_id, i)) {
+				return false;
+			}
+			any = true;
+		}
+		return any;
+	}
